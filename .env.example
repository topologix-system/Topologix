# Topologix Environment Configuration Template
#
# SECURITY NOTICE:
# - DO NOT commit .env to version control (already in .gitignore)
# - Set restrictive permissions: chmod 600 .env
# - Generate unique secrets for production (see JWT_SECRET_KEY comment)
# - Review README security notes before deploying to production
#
# USAGE:
# Quick Start:
#   - Copy this template: cp .env.example .env
#   - Development: use docker-compose.dev.yaml
#   - Production: set FLASK_ENV=production, FLASK_DEBUG=False,
#     provide SECRET_KEY/JWT_SECRET_KEY/CSRF_SECRET_KEY, and keep
#     VITE_API_BASE_URL empty when using the bundled nginx reverse proxy
#
# Or use docker-compose --env-file option:
#   - Development: docker compose --env-file .env -f docker-compose.dev.yaml up -d
#   - Production:  docker compose --env-file .env -f docker-compose.yaml up -d
#
# Then start the containers:
#   docker compose up -d

# ============================================
# Backend Configuration
# ============================================

# Backend Command (Environment-specific)
# Development (Flask dev server with hot reload):
#   BACKEND_COMMAND=python app.py
# Production (Gunicorn WSGI server):
#   BACKEND_COMMAND=gunicorn --worker-class gevent --workers 1 --bind 0.0.0.0:5000 --timeout 120 --access-logfile - --error-logfile - --log-level info 'app:app'

FLASK_ENV=development
FLASK_DEBUG=True

BATFISH_HOST=batfish
BATFISH_PORT=9996

# Batfish container image. Compose defaults to a digest validated with the
# pinned pybatfish version; set this to test another Batfish release.
# BATFISH_IMAGE=batfish/allinone@sha256:09817554db90e2f2674b72562c2d659427094187de0a3dfc23534ab58bf26207

# Upper bound in seconds for one Batfish query (minimum 10). Prevents a stuck
# query from holding the process-wide Batfish request lock indefinitely. The
# maintained Compose files explicitly pass this setting to the backend; other
# launch methods must export it to the backend process themselves.
# The value must be an integer; values below 10 are raised to 10, and a non-integer stops backend startup.
# BATFISH_QUERY_TIMEOUT_SECONDS=120

# CORS Origins (comma-separated)
# Add your frontend URLs here. For production, replace with your actual domain
# Example: CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=http://localhost:3000

# ============================================
# Authentication (Optional Feature)
# ============================================

AUTH_ENABLED=false

# Allow User Self-Registration
# Set to 'true' to allow new users to register themselves
# Set to 'false' to restrict registration to admin-only (more secure for production)
# SECURITY WARNING: When enabled, anyone can create an account. Consider enabling
# email verification and implementing proper monitoring/moderation.
# Default: 'true' for easier OSS onboarding
ALLOW_REGISTRATION=true

# Default Admin Credentials (only used when AUTH_ENABLED=true)
# Leave AUTH_DEFAULT_ADMIN_PASS empty to trigger first-time setup wizard
AUTH_DEFAULT_ADMIN_USER=admin
AUTH_DEFAULT_ADMIN_PASS=

# JWT Secret Keys (auto-generated if not set, but should be set in production)
# Generate using: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=
# JWT_SECRET_KEY=
# CSRF_SECRET_KEY=

# CSRF protection: 'session' (stateful, default) or 'double-submit' (stateless)
# Double-submit recommended for scaled deployments. See README security notes for details.
# CSRF_MODE=session

# JWT access token expiry in seconds (default: 3600 = 1 hour)
# OWASP ASVS L2: <12h, L3: <15min. For high-security: 900 (15min)
JWT_ACCESS_TOKEN_EXPIRES=3600

# ============================================
# Login Security Configuration
# ============================================

# Maximum Failed Login Attempts Before Lockout
# Number of consecutive failed login attempts allowed before account lockout
# OWASP ASVS recommendation: 5-10 attempts
# Default: 5 attempts
# ACCOUNT_LOCKOUT_THRESHOLD=5

# Account Lockout Duration (in minutes)
# How long to lock the account after exceeding failed login threshold
# Default: 30 minutes
# LOGIN_LOCKOUT_DURATION_MINUTES=30

# NOTE: IP-based rate limiting is currently disabled
# Reason: This application may be deployed behind NAT/NAPT gateways, load balancers,
# or proxies where multiple users share the same IP address. IP-based blocking
# could incorrectly block legitimate users in these environments.
# Security is provided by account-based lockout (ACCOUNT_LOCKOUT_THRESHOLD).
#
# If you are certain your deployment has unique client IPs, you can implement
# IP-based blocking by modifying backend/security/auth.py (see line 433-446).

# Maximum Login History Records
# Number of login history records to keep per user
# Used for audit trails and security monitoring
# Default: 50 records
# LOGIN_HISTORY_MAX_RECORDS=50

# Maximum Failed Login Attempts Records
# Number of failed login attempt records to keep
# Used for security monitoring and attack detection
# Default: 100 records
# FAILED_LOGIN_ATTEMPTS_MAX_RECORDS=100

# Maximum Blocked IPs Records
# Number of blocked IP records to keep
# Used for security monitoring and attack pattern analysis
# Default: 200 records
# BLOCKED_IPS_MAX_RECORDS=200

# ============================================
# Email Configuration (for password reset, notifications, etc.)
# ============================================

# Email Provider: 'console' (print to console), 'smtp' (send via SMTP), 'disabled' (no email)
# Default: 'console' for development
EMAIL_PROVIDER=console

# Email From Address and Name
EMAIL_FROM=noreply@topologix.local
EMAIL_FROM_NAME=Topologix

# SMTP Configuration (only used when EMAIL_PROVIDER=smtp)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Password Reset Configuration
# Token expiry time in seconds (default: 3600 = 1 hour)
PASSWORD_RESET_TOKEN_EXPIRY=3600

# Frontend base URL for password reset links
# Update this to match your frontend URL
PASSWORD_RESET_URL_BASE=http://localhost:3000

# ============================================
# Database Configuration (snapshot version history in both modes,
# authentication data when AUTH_ENABLED=true)
# ============================================

# Database URL - supports SQLite, PostgreSQL, MySQL
# SQLite (default - good for development and small deployments):
DATABASE_URL=sqlite:////app/data/topologix.db

# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://username:password@postgres:5432/topologix

# MySQL:
# DATABASE_URL=mysql+pymysql://username:password@mysql:3306/topologix

# Notes:
# - The database is initialized in both modes because it stores the snapshot version
#   history; with AUTH_ENABLED=false a database failure makes versioning unavailable
#   instead of stopping the backend
# - For Docker, use /app/data/topologix.db for SQLite to persist in volume
# - For PostgreSQL/MySQL, add service to docker-compose.yaml
# - Switching DATABASE_URL to a new, empty database starts an empty snapshot history;
#   the history objects of the previous database stay on disk until removed by hand
# - A copy of the database (backup restore, clone) keeps its history identity (db_id).
#   Never run a copy, not even temporarily, against the SNAPSHOT_HISTORY_DIR the original
#   uses: its garbage collection removes objects that only the original references.
#   Copy the object store together with the database, point SNAPSHOT_HISTORY_DIR at that
#   copy and give the copy its own RESULT_CACHE_DIR (or DATA_DIR). See README.

# SQL statement logging. Keep disabled unless debugging a local non-sensitive database,
# because SQL values can include password hashes and other sensitive operational data.
SQLALCHEMY_ECHO=false

# ============================================
# Snapshot History and Result Cache
# ============================================
# See README "Snapshot History and Result Cache". Both compose files pass these
# variables to the backend; an empty value is treated as unset and selects the
# default shown. EXTERNAL_CHANGE_SETTLE_SECONDS accepts a decimal number; the other
# numeric variables accept only whole numbers. A value that cannot be parsed, such as
# 1.5 for a whole-number variable, any non-numeric text or a number that is not finite
# (1e999), stops backend startup, and
# a negative value is treated as 0 without a warning (for example,
# HISTORY_GC_GRACE_SECONDS=-1 removes the garbage-collection grace). 0 is a literal
# limit and never means unlimited: RESULT_CACHE_MAX_BYTES=0 or
# RESULT_CACHE_MAX_ENTRIES=0 evicts every cached result right after it is stored,
# SNAPSHOT_DIFF_MAX_BYTES=0 reports every non-empty file as too large, and
# SNAPSHOT_DIFF_MAX_LINES=0 shows no diff lines and reports every changed text file
# with at least one differing line as truncated (binary and too-large files keep
# those flags).

# Persistent data directory: default SQLite database, history objects, result
# cache, staging copies and the AUTH_ENABLED=false active snapshot file.
# Default: /app/data when that directory exists (Docker images, backend-db volume).
# Without it the backend uses a temporary directory, logs a WARNING and disables
# versioning and the result cache, so non-Docker runs must set DATA_DIR.
# DATA_DIR=/app/data

# Defaults: <DATA_DIR>/result_cache and <DATA_DIR>/snapshot_history.
# SNAPSHOTS_DIR, RESULT_CACHE_DIR, SNAPSHOT_HISTORY_DIR and <DATA_DIR>/_invalid-namespace
# must not equal or contain one another, and DATA_DIR must not equal or lie inside
# SNAPSHOTS_DIR. A violation logs one ERROR, turns the result cache off and makes
# versioning unavailable.
# RESULT_CACHE_DIR=/app/data/result_cache
# SNAPSHOT_HISTORY_DIR=/app/data/snapshot_history

# History namespace of this stack in the database. It must match ^[A-Za-z0-9_-]{1,64}$,
# must not be result_cache, snapshot_history or _invalid-namespace, and <DATA_DIR>/<value>
# must not overlap the directories above. Empty: the UUID the backend stores in
# <SNAPSHOTS_DIR>/.topologix-store.json, which needs a store filesystem with hard-link
# support (otherwise set DEPLOYMENT_ID). Recommended when several stacks share one
# database or backend-db volume, as the two compose files do.
# - An existing deployment that adopts DEPLOYMENT_ID must set it to the UUID in its
#   .topologix-store.json, or its history is detached.
# - Keep .topologix-store.json when moving a snapshot store. Delete it from a store
#   duplicated for another stack that shares the database (or give the stacks distinct
#   DEPLOYMENT_IDs), or both stores share one history per snapshot.
# - The first start under a new namespace logs a WARNING when snapshots of the store
#   have history under other namespaces. If this deployment changed its namespace,
#   restore the previous DEPLOYMENT_ID / marker value, or purge the detached namespace
#   after checking GET /api/admin/snapshot-history/namespaces. If the snapshot folders
#   were copied from another stack that shares the database, no action is needed.
# - Detached history is removed only by DELETE /api/admin/snapshot-history/orphans with
#   {"namespace": "<ns>", "confirm": "<ns>"}, which destroys that namespace's history
#   whichever stack owns it.
# docker-compose.yaml reads DEPLOYMENT_ID and docker-compose.dev.yaml reads
# DEV_DEPLOYMENT_ID, because both compose files share this .env.
# DEPLOYMENT_ID=
# DEV_DEPLOYMENT_ID=

# Backend build id, part of every cached result's key. Leave it empty: the id is then
# derived from the backend sources. A set value must be unique per backend build,
# because a constant value makes an upgraded backend serve results computed by the
# old code. docker-compose.yaml reads APP_BUILD_ID and docker-compose.dev.yaml reads
# DEV_APP_BUILD_ID.
# APP_BUILD_ID=
# DEV_APP_BUILD_ID=

# Result cache kill switch (default true). Empty or true in any letter case (TRUE, True)
# turns the cache on and any other value turns it off; the cache is also off with the
# temporary-directory DATA_DIR or overlapping storage directories.
# With RESULT_CACHE_ENABLED set to any other value, requests behave as without the
# result cache: no cached results, no identity response headers, no restore of the
# AUTH_ENABLED=false active snapshot at start, and cached endpoints answer with
# Cache-Control: no-store. Snapshot versioning stays on.
# RESULT_CACHE_ENABLED=true

# Result cache limits for the whole cache directory, and the seconds during which
# recently stored or served results are evicted last.
# RESULT_CACHE_MAX_BYTES=536870912
# RESULT_CACHE_MAX_ENTRIES=4000
# RESULT_CACHE_PROTECT_SECONDS=900

# Seconds an unreferenced history object is kept before garbage collection, which
# runs at startup, hourly and after history deletions, removes it (a snapshot
# deletion and the admin purges skip this grace).
# HISTORY_GC_GRACE_SECONDS=600

# Accepts a lost history object store. Set it only to the db_id in the path named by
# the startup ERROR "Snapshot history object store <SNAPSHOT_HISTORY_DIR>/<db_id>/objects
# is missing ...", restart, then reset each affected snapshot's history with "Delete
# history (all)" and remove the variable once the startup WARNING reports 0 marked
# snapshots. Any other value is ignored with a WARNING.
# HISTORY_ACCEPT_STORE_LOSS=

# Seconds the files of a snapshot changed outside the API must stay unchanged before
# the change is recorded as an external version.
# EXTERNAL_CHANGE_SETTLE_SECONDS=10

# Batfish version probe: seconds a probed version is reused, and seconds after the last
# successful probe or snapshot activation during which the last known version keeps
# serving cached results while Batfish cannot be reached.
# BATFISH_VERSION_PROBE_TTL_SECONDS=300
# BATFISH_VERSION_GRACE_SECONDS=3600

# Per-file version diff limits: a file above SNAPSHOT_DIFF_MAX_BYTES bytes on either side,
# or one whose comparison exceeds a fixed internal work budget, is reported as too large;
# hunks are cut after SNAPSHOT_DIFF_MAX_LINES diff lines.
# SNAPSHOT_DIFF_MAX_BYTES=524288
# SNAPSHOT_DIFF_MAX_LINES=2000

# ============================================
# Frontend Configuration
# ============================================

# Backend API endpoint. Empty string uses the bundled nginx /api reverse proxy.
# Docker compose: keep empty. Non-Docker local Vite dev: http://localhost:5000
VITE_API_BASE_URL=

# Authentication (must match backend AUTH_ENABLED)
VITE_AUTH_ENABLED=false

# Timezone for displaying dates (IANA timezone identifier)
# Default: Asia/Tokyo (JST, UTC+9)
# Examples: America/New_York, Europe/London, UTC
VITE_TIMEZONE=Asia/Tokyo

# ============================================
# Reverse Proxy Configuration
# ============================================

# Behind Reverse Proxy Flag
# Set to 'true' if Flask application is behind a reverse proxy (nginx, Caddy, etc.)
# Set to 'false' for direct connections (not recommended for production)
#
# CRITICAL SECURITY WARNING:
# - When 'true': Flask will trust X-Forwarded-For headers for IP extraction
# - When 'false': Flask will use direct connection IP (ignores proxy headers)
# - Setting 'true' without actual proxy: SECURITY VULNERABILITY (IP spoofing possible)
# - Setting 'false' with actual proxy: All IPs will appear as proxy IP
#
# This setting MUST match your actual infrastructure setup!
# Docker deployments with nginx: Set to 'true'
# Default: 'false' (safer default - prevents IP spoofing if misconfigured)
BEHIND_REVERSE_PROXY=false

# Comma-separated list of trusted reverse proxy IPs for gunicorn forwarded_allow_ips
# Only relevant when using gunicorn in production
# TRUSTED_PROXY_IPS=127.0.0.1

# Number of trusted proxy layers between client and backend
# This setting is critical for proper IP address extraction in security logs
#
# SECURITY WARNING: Incorrect values can allow IP spoofing attacks!
#
# Common values:
#   0 = No proxy (direct connection - not recommended for production)
#   1 = Single proxy layer (nginx in Docker, typical setup) [DEFAULT]
#   2 = Two proxy layers (CDN/Caddy -> nginx -> Flask)
#   3+ = Multiple proxy layers (complex infrastructure)
#
# How to determine the correct value:
#   Count the number of proxies between the internet and your Flask application
#   Example: Internet -> Cloudflare (1) -> nginx (2) -> Flask = TRUSTED_PROXY_COUNT=2
#
# Default: 1 (single nginx proxy in Docker)
# TRUSTED_PROXY_COUNT=1

# ============================================
# Docker Configuration
# ============================================

# Docker Image Names
# Override these when deploying to custom registries or for forked repositories
# Useful for CI/CD pipelines and custom deployments
#
# Format: registry/namespace/image:tag
# Examples:
#   - GitHub Container Registry: ghcr.io/username/topologix/backend:latest
#   - Docker Hub: username/topologix-backend:v1.0.0
#   - Private Registry: registry.example.com/topologix/backend:latest
#
# Backend Docker Image
# Default: ghcr.io/topologix-system/topologix/backend:latest
# BACKEND_IMAGE=ghcr.io/topologix-system/topologix/backend:latest

# Frontend Docker Image
# Default: ghcr.io/topologix-system/topologix/frontend:latest
# FRONTEND_IMAGE=ghcr.io/topologix-system/topologix/frontend:latest

# ============================================
# Advanced Configuration
# ============================================

# Redis (for production caching and session storage)
# REDIS_URL=redis://localhost:6379/0

# Logging
# LOG_LEVEL=INFO
# LOG_DIR=./logs
# LOG_FILE=./logs/topologix.log
# AUDIT_LOG_FILE=./logs/topologix_audit.log

# File Upload
# MAX_CONTENT_LENGTH=10485760  # 10MB in bytes
# UPLOAD_FOLDER=./uploads

# Snapshot storage path
# Docker compose default: /app/snapshots (matches snapshots-data volume)
# Non-Docker local execution: ./snapshots
# SNAPSHOTS_DIR=/app/snapshots

# Flask Host Binding (Docker: 0.0.0.0, Production behind proxy: 127.0.0.1)
# HOST=0.0.0.0

# Testing Configuration
# Enable Flask testing mode (disables error catching for better test debugging)
# WARNING: Never enable in production! Only use during automated testing.
# FLASK_TESTING=false

# Port Configuration
# Override the default port for backend service
# Default: 5000 (standard Flask port)
# Note: When using Docker, this is typically handled by docker-compose.yaml
# PORT=5000
